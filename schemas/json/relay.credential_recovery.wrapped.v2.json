{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iscp.dev/json/relay.credential_recovery.wrapped.v2.json",
  "title": "ISCP Relay Credential Recovery Wrapped v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "ciphersuite", "recovery_public_key", "server_public_key", "nonce", "ciphertext"],
  "properties": {
    "type": { "const": "iscp.relay.credential_recovery.wrapped.v2" },
    "ciphersuite": { "const": "ISCP_V2_X25519_HKDF_SHA256_CHACHA20POLY1305" },
    "recovery_public_key": { "type": "string", "contentEncoding": "base64url", "minLength": 1 },
    "server_public_key": { "type": "string", "contentEncoding": "base64url", "minLength": 1 },
    "nonce": { "type": "string", "contentEncoding": "base64url", "minLength": 1 },
    "ciphertext": { "type": "string", "contentEncoding": "base64url", "minLength": 1 }
  }
}
